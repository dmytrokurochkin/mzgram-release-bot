# Токен бота від @BotFather. На сервері його записує install.sh, нікому не показуйте
BOT_TOKEN=

# Канал для релізів: числовий ID (-100...) або @username. Бот має бути адміністратором
# з правами "Публікація повідомлень" і "Редагування повідомлень" (без нього не закріпить пост)
CHANNEL_ID=

# Адреса локального telegram-bot-api (запущений з --local): файли до 2000 МБ замість 50 МБ
BOT_API_URL=http://127.0.0.1:8081

# Telegram ID адмінів через кому: їм приходять помилки, вони можуть /status, /repost, /mark_posted.
# Свій ID можна дізнатися в @userinfobot. Адмін має хоча б раз натиснути /start у бота
ADMIN_IDS=

# Репозиторії GitHub, чиї релізи йдуть у канал
REPOS=dmytrokurochkin/MZGram-Android,dmytrokurochkin/MZGram-Desktop

# Як часто питати GitHub, секунд. Без GITHUB_TOKEN GitHub дає 60 запитів на годину
# на IP-адресу сервера, спільні з усіма іншими програмами з цієї адреси, і рахує кожен
# запит, навіть відповідь "нічого не змінилося" (304). 600 с на два репозиторії = 12 на годину
POLL_INTERVAL=600

# true: публікувати і бета-релізи (prerelease на GitHub). Поки лише стабільні
PUBLISH_PRERELEASES=false

# Необов'язково, але бажано: токен GitHub без жодних прав (fine-grained token, доступ
# "Public repositories (read-only)"), github.com/settings/personal-access-tokens.
# З ним ліміт 5000 запитів на годину лише для цього токена, і відповіді 304 не рахуються.
# Коли ліміт вичерпано, бот мовчки чекає до його відновлення і один раз пише адміну
GITHUB_TOKEN=
